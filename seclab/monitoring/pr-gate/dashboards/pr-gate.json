{
 "uid": "seclab-pr-gate",
 "title": "Security Gate — Pull Requests",
 "tags": [
  "seclab",
  "devsecops"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "10m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "PRs bloqueados (runs fallidos)",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "github"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "github"
     },
     "type": "json",
     "source": "url",
     "format": "table",
     "parser": "backend",
     "url": "https://api.github.com/repos/Hackwy402/desarrollo-seguro-ucp/actions/workflows/gate.yml/runs?event=pull_request&per_page=100&status=failure",
     "url_options": {
      "method": "GET",
      "data": ""
     },
     "root_selector": "",
     "columns": [
      {
       "selector": "total_count",
       "text": "total",
       "type": "number"
      }
     ]
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Runs en verde",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "github"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "github"
     },
     "type": "json",
     "source": "url",
     "format": "table",
     "parser": "backend",
     "url": "https://api.github.com/repos/Hackwy402/desarrollo-seguro-ucp/actions/workflows/gate.yml/runs?event=pull_request&per_page=100&status=success",
     "url_options": {
      "method": "GET",
      "data": ""
     },
     "root_selector": "",
     "columns": [
      {
       "selector": "total_count",
       "text": "total",
       "type": "number"
      }
